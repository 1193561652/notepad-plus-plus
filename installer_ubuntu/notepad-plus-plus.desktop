[Desktop Entry]
Type=Application
Name=Notepad++
GenericName=Text Editor
Comment=Edit text and source code
Exec=notepad++ %F
Icon=notepad-plus-plus
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;
StartupNotify=true
# The installed executable is /usr/bin/notepad++.  This must match the X11
# WM_CLASS used by Qt, rather than the internal CMake target name, otherwise
# GNOME/Ubuntu Dock treats the running window as a separate application.
StartupWMClass=notepad++
