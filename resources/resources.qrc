<RCC>
    <qresource prefix="/">
        <!-- 语言文件（XML 格式，与原版一致，运行时热切换） -->
        <file>nativeLang/chineseSimplified.xml</file>
        <!-- 原版兼容语言包：选择语言时完整复制为 nativeLang.xml -->
        <file>localization/chineseSimplified.xml</file>
        <!-- 翻译文件（保留，用于回退兼容） -->
        <file>translations/zh_CN.qm</file>
        <!-- 默认配色主题 -->
        <file>stylers.model.xml</file>
        <!-- 原版默认配置模型（用于用户目录/exe目录缺失时回退） -->
        <file>config.model.xml</file>
        <file>langs.model.xml</file>
        <file>shortcuts.xml</file>
        <file>contextMenu.xml</file>
        <file>toolbarIcons.xml</file>
        <file>userDefineLang.xml</file>
        <!-- nppPluginList v1.5.4（Notepad++ v8.4.6 发布基线） -->
        <file>pluginList/windows/pl.x86.json</file>
        <file>pluginList/windows/pl.x64.json</file>
        <file>pluginList/windows/pl.arm64.json</file>
        <!-- 程序图标 -->
        <file>icons/npp.ico</file>
        <!-- 标签页状态图标 -->
        <file>icons/saved.ico</file>
        <file>icons/unsaved.ico</file>
        <file>icons/readonly.ico</file>
        <!-- 工具栏彩色BMP图标 -->
        <file>icons/newFile.bmp</file>
        <file>icons/openFile.bmp</file>
        <file>icons/saveFile.bmp</file>
        <file>icons/saveAll.bmp</file>
        <file>icons/closeFile.bmp</file>
        <file>icons/closeAll.bmp</file>
        <file>icons/cut.bmp</file>
        <file>icons/copy.bmp</file>
        <file>icons/paste.bmp</file>
        <file>icons/undo.bmp</file>
        <file>icons/redo.bmp</file>
        <file>icons/find.bmp</file>
        <file>icons/findReplace.bmp</file>
        <file>icons/zoomIn.bmp</file>
        <file>icons/zoomOut.bmp</file>
        <file>icons/wrap.bmp</file>
        <file>icons/invisibleChar.bmp</file>
        <file>icons/indentGuide.bmp</file>
        <file>icons/userDefineDlg_off.ico</file>
        <file>icons/startRecord.bmp</file>
        <file>icons/stopRecord.bmp</file>
        <file>icons/playRecord.bmp</file>
        <file>icons/saveRecord.bmp</file>
        <file>icons/docMap.bmp</file>
        <file>icons/docList.bmp</file>
        <file>icons/functionList.bmp</file>
        <file>icons/fileBrowser.bmp</file>
        <file>icons/print.bmp</file>
    </qresource>
</RCC>
